SHUTDOWN IMMEDIATE;
STARTUP MOUNT;
BACKUP INCREMENTAL LEVEL 0 DEVICE TYPE DISK
  FORMAT '/opt/oracle/recovery_data/Incremental_Backup/%U'
  TAG 'INCR_L0_%T'
  DATABASE;
BACKUP DEVICE TYPE DISK
  FORMAT '/opt/oracle/recovery_data/Incremental_Backup/%U'
  TAG 'ARCH_INCR_L0_%T'
  ARCHIVELOG ALL NOT BACKED UP;
ALTER DATABASE OPEN;
ALTER PLUGGABLE DATABASE ALL OPEN;