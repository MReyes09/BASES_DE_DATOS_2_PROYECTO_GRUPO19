SHUTDOWN IMMEDIATE;
STARTUP MOUNT;
BACKUP DEVICE TYPE DISK
  FORMAT '/opt/oracle/recovery_data/Full_Backup/%U'
  TAG 'FULL_DB_%T'
  DATABASE;
BACKUP DEVICE TYPE DISK
  FORMAT '/opt/oracle/recovery_data/Full_Backup/%U'
  TAG 'ARCH_FULL_%T'
  ARCHIVELOG ALL NOT BACKED UP;
ALTER DATABASE OPEN;
ALTER PLUGGABLE DATABASE ALL OPEN;